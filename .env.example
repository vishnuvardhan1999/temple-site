# Contact form: free access key from https://web3forms.com (register it with the temple email).
# Copy this file to .env.local and fill in the key.
VITE_WEB3FORMS_KEY=

# Registration form: server-only Google service-account credentials.
# Never prefix these variables with VITE_ or commit their real values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME="Form Responses 1"

# Land appeal: server-only Zeffy API key. The server finds the campaign by
# matching the public URL in temple.js.
ZEFFY_API_KEY=
